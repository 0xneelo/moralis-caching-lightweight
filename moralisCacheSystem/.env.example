NODE_ENV=development
PORT=3001
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Backend-only. Never expose this in frontend env vars.
MORALIS_API_KEY=
MORALIS_DAILY_CU_BUDGET=3333333

# OHLCV provider selection. API callers may override per request with provider=moralis|coingecko.
OHLCV_DEFAULT_PROVIDER=moralis
COINGECKO_API_KEY=
COINGECKO_API_BASE_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_DAILY_CREDIT_BUDGET=100000
COINGECKO_MAX_SYNC_PAGES=8
COINGECKO_OHLCV_ENABLED=true

DATABASE_URL=postgres://postgres:postgres@localhost:5432/moralis_cache
REDIS_URL=redis://localhost:6379

CHART_PROVIDER_ENABLED=true
MAX_SYNC_MORALIS_PAGES=8
MAX_SYNC_GAP_CANDLES=8000
DEFAULT_CURRENCY=usd
EXTERNAL_API_KEY_REQUEST_RATE_LIMIT=1200
EXTERNAL_API_KEY_CACHE_MISS_RATE_LIMIT=60
EXTERNAL_API_KEY_DAILY_CU_BUDGET=3000000

# Optional simple admin protection for /api/admin/*
ADMIN_API_KEY=change-me
