NODE_ENV=production
PORT=3001
API_PUBLIC_PORT=3001
LOG_LEVEL=info

# Required secrets
MORALIS_API_KEY=replace-with-moralis-key
# Required when OHLCV_DEFAULT_PROVIDER=coingecko or COINGECKO_OHLCV_ENABLED=true.
COINGECKO_API_KEY="replace-with-coingecko-pro-key"
ADMIN_API_KEY=replace-with-long-random-admin-key
POSTGRES_PASSWORD=replace-with-long-random-db-password

# Docker Compose overrides DATABASE_URL/REDIS_URL to service hostnames.
# Keep these here for non-compose production runs only.
DATABASE_URL=postgres://postgres:replace-with-long-random-db-password@postgres:5432/moralis_cache
REDIS_URL=redis://redis:6379

MORALIS_DAILY_CU_BUDGET=3333333
OHLCV_DEFAULT_PROVIDER=moralis
COINGECKO_API_BASE_URL=https://pro-api.coingecko.com/api/v3
COINGECKO_DAILY_CREDIT_BUDGET=100000
COINGECKO_MAX_SYNC_PAGES=8
COINGECKO_OHLCV_ENABLED=true
CHART_PROVIDER_ENABLED=true
MAX_SYNC_MORALIS_PAGES=8
MAX_SYNC_GAP_CANDLES=8000
DEFAULT_CURRENCY=usd
EXTERNAL_API_KEY_REQUEST_RATE_LIMIT=1200
EXTERNAL_API_KEY_CACHE_MISS_RATE_LIMIT=60
EXTERNAL_API_KEY_DAILY_CU_BUDGET=3000000
